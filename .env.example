# Copy to .env.local for local development. Production values live in the Vercel project.
# Never commit real values: the repository is public.

# Order form delivery (app/api/orders/route.ts)
RESEND_API_KEY=
ORDERS_TO_EMAIL=
ORDERS_FROM_EMAIL=

# On-page editor sign-in (lib/auth.ts)
# Accepted usernames, comma-separated, case-insensitive.
ADMIN_USERNAME=
# scrypt:<salt>:<hash> — generate with hashPassword() from lib/auth.ts. Never the password itself.
ADMIN_PASSWORD_HASH=
# A long random string. Changing it signs every editor out.
SESSION_SECRET=

# Saved page copy (lib/content.ts). Added automatically when a Blob store is connected
# to the Vercel project. Leave unset locally to save to .data/content.json instead.
BLOB_READ_WRITE_TOKEN=
